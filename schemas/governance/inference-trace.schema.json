{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sankarshanmukhopadhyay.github.io/dpi-ai-governance-artifacts/schemas/governance/inference-trace.schema.json",
  "title": "Consequential Inference Trace",
  "description": "Portable evidence binding an automated inference to a consequential decision while preserving the normative rule as a distinct authority source.",
  "type": "object",
  "additionalProperties": false,
  "required": ["trace_id", "decision_ref", "executed_at", "inference", "inputs", "output", "normative_role", "rulebook_ref", "integrity"],
  "properties": {
    "trace_id": {"type": "string", "minLength": 1},
    "decision_ref": {"type": "string", "minLength": 1},
    "executed_at": {"type": "string", "format": "date-time"},
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "artifact_digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "artifact_digest": {"type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$"},
        "provider_ref": {"type": "string"}
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "ref", "sha256"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "ref": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
        }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {"type": ["string", "number", "boolean", "null"]}
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": {"type": ["string", "number", "boolean", "null"]}
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": {"type": ["string", "number", "boolean", "object", "array", "null"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "normative_role": {
      "type": "string",
      "enum": ["advisory", "eligibility_input", "risk_input", "ranking_input", "classification_input", "fraud_signal", "other"]
    },
    "rulebook_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rulebook_id", "version"],
      "properties": {
        "rulebook_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "rule_ref": {"type": "string"}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trace_sha256"],
      "properties": {
        "trace_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "signature_ref": {"type": "string"}
      }
    }
  }
}
