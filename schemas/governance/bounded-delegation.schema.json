{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sankarshanmukhopadhyay.github.io/dpi-ai-governance-artifacts/schemas/governance/bounded-delegation.schema.json",
  "title": "Bounded Delegation Record",
  "type": "object",
  "required": ["delegation_id", "authority_id", "delegator", "delegate", "scope", "validity", "revocation", "status"],
  "properties": {
    "delegation_id": {"type": "string", "pattern": "^DEL-[A-Z0-9._-]+$"},
    "authority_id": {"type": "string", "minLength": 1},
    "delegator": {"type": "string", "minLength": 1},
    "delegate": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "required": ["actions", "resources", "purposes"],
      "properties": {
        "actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "resources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "purposes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "constraints": {"type": "object"}
      },
      "additionalProperties": false
    },
    "validity": {
      "type": "object",
      "required": ["not_before", "not_after"],
      "properties": {
        "not_before": {"type": "string", "format": "date-time"},
        "not_after": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "revocation": {
      "type": "object",
      "required": ["mechanism", "authority"],
      "properties": {
        "mechanism": {"type": "string", "minLength": 1},
        "authority": {"type": "string", "minLength": 1},
        "revoked_at": {"type": ["string", "null"], "format": "date-time"},
        "reason": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "status": {"type": "string", "enum": ["active", "suspended", "revoked", "expired"]},
    "issued_at": {"type": "string", "format": "date-time"},
    "evidence_ref": {"type": "string"}
  },
  "additionalProperties": false
}
