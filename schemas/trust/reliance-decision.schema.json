{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://sankarshanmukhopadhyay.github.io/dpi-ai-governance-artifacts/schemas/trust/reliance-decision.schema.json",
  "title":"Reliance Decision","type":"object","additionalProperties":false,
  "required":["decision_id","decided_at","profile_ref","evidence_ref","relying_institution","downstream_decision","purpose","jurisdiction","decision","reason_codes"],
  "properties":{
    "decision_id":{"type":"string"},"decided_at":{"type":"string","format":"date-time"},"profile_ref":{"type":"string"},"evidence_ref":{"type":"string"},
    "relying_institution":{"type":"string"},"downstream_decision":{"type":"string"},"purpose":{"type":"string"},"jurisdiction":{"type":"string"},
    "decision":{"enum":["admit","reject","defer"]},"reason_codes":{"type":"array","minItems":1,"items":{"type":"string"}},
    "conditions_met":{"type":"array","items":{"type":"string"}},"recourse_ref":{"type":"string"}
  }
}
